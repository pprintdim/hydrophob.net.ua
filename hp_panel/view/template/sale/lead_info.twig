{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="return confirm('{{ text_confirm }}');"><i class="fa fa-trash-o"></i></a>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-envelope-o"></i> {{ lead.subject }}</h3>
      </div>
      <div class="panel-body">
        <table class="table table-bordered">
          <tr><td style="width:200px">{{ column_form }}</td><td>{{ lead.form_name }}</td></tr>
          <tr><td>{{ column_name }}</td><td>{{ lead.name }}</td></tr>
          <tr><td>{{ entry_email }}</td><td>{% if lead.email %}<a href="mailto:{{ lead.email }}">{{ lead.email }}</a>{% endif %}</td></tr>
          <tr><td>{{ entry_telephone }}</td><td>{% if lead.telephone %}<a href="tel:{{ lead.telephone }}">{{ lead.telephone }}</a>{% endif %}</td></tr>
          {% if lead.city %}<tr><td>{{ entry_city }}</td><td>{{ lead.city }}</td></tr>{% endif %}
          {% if lead.message %}<tr><td>{{ entry_message }}</td><td>{{ lead.message|nl2br }}</td></tr>{% endif %}
          <tr><td>{{ column_date_added }}</td><td>{{ lead.date_added }}</td></tr>
          <tr><td>IP</td><td>{{ lead.ip }}</td></tr>
        </table>
      </div>
    </div>
  </div>
</div>
{{ footer }}
