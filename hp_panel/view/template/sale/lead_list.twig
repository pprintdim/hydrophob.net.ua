{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}{% if total_new %} <span class="label label-warning">{{ total_new }}</span>{% endif %}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-envelope-o"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="get" class="form-inline" style="margin-bottom:15px">
          <input type="hidden" name="route" value="sale/lead" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          <select name="filter_form" class="form-control" onchange="this.form.submit();">
            {% for form in forms %}
            <option value="{{ form.code }}"{% if form.code == filter_form %} selected="selected"{% endif %}>{{ form.name }}</option>
            {% endfor %}
          </select>
        </form>

        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_form }}</td>
                <td class="text-left">{{ column_name }}</td>
                <td class="text-left">{{ column_contact }}</td>
                <td class="text-left">{{ column_date_added }}</td>
                <td class="text-right">{{ column_action }}</td>
              </tr>
            </thead>
            <tbody>
              {% if leads %}
              {% for lead in leads %}
              <tr{% if not lead.status %} class="warning"{% endif %}>
                <td class="text-left">{{ lead.form_name }}{% if not lead.status %} <span class="label label-warning">{{ text_new }}</span>{% endif %}</td>
                <td class="text-left">{{ lead.name }}</td>
                <td class="text-left">
                  {% if lead.email %}<a href="mailto:{{ lead.email }}">{{ lead.email }}</a>{% endif %}
                  {% if lead.telephone %}<br /><a href="tel:{{ lead.telephone }}">{{ lead.telephone }}</a>{% endif %}
                </td>
                <td class="text-left">{{ lead.date_added }}</td>
                <td class="text-right">
                  <a href="{{ lead.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-info btn-sm"><i class="fa fa-eye"></i></a>
                  <a href="{{ lead.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn-sm" onclick="return confirm('{{ text_confirm }}');"><i class="fa fa-trash-o"></i></a>
                </td>
              </tr>
              {% endfor %}
              {% else %}
              <tr><td class="text-center" colspan="5">{{ text_no_results }}</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
