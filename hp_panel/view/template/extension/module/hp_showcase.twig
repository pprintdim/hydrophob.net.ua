{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-hp-showcase" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <style>
      .hp-lang-pane{padding-top:15px}
    </style>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-hp-showcase" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-type">{{ entry_type }}</label>
            <div class="col-sm-10">
              <select name="type" id="input-type" class="form-control">
                <option value="bestseller"{% if type == 'bestseller' %} selected="selected"{% endif %}>{{ text_type_bestseller }}</option>
                <option value="latest"{% if type == 'latest' %} selected="selected"{% endif %}>{{ text_type_latest }}</option>
                <option value="special"{% if type == 'special' %} selected="selected"{% endif %}>{{ text_type_special }}</option>
                <option value="manual"{% if type == 'manual' %} selected="selected"{% endif %}>{{ text_type_manual }}</option>
              </select>
            </div>
          </div>

          <div class="form-group" id="group-product" {% if type != 'manual' %}style="display:none"{% endif %}>
            <label class="col-sm-2 control-label" for="input-product">
              <span data-toggle="tooltip" title="{{ help_product }}">{{ entry_product }}</span>
            </label>
            <div class="col-sm-10">
              <input type="text" name="product_name" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
              <div id="hp-showcase-product" class="well well-sm" style="height: 150px; overflow: auto;">
                {% for product in products %}
                <div id="hp-showcase-product{{ product.product_id }}"><i class="fa fa-minus-circle"></i> {{ product.name }}
                  <input type="hidden" name="product[]" value="{{ product.product_id }}" />
                </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-limit">{{ entry_limit }}</label>
            <div class="col-sm-10">
              <input type="text" name="limit" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-anchor">
              <span data-toggle="tooltip" title="{{ help_anchor }}">{{ entry_anchor }}</span>
            </label>
            <div class="col-sm-10">
              <input type="text" name="anchor" value="{{ anchor }}" placeholder="promo" id="input-anchor" class="form-control" />
            </div>
          </div>

          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#" data-lang="{{ language.language_id }}"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>

          <div class="hp-lang-pane">
            {% for language in languages %}
            <div class="js-lang js-lang-{{ language.language_id }}"{% if not loop.first %} hidden{% endif %}>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_heading }}</label>
                <div class="col-sm-10">
                  <input type="text" name="showcase_description[{{ language.language_id }}][heading_title]" value="{{ showcase_description[language.language_id] ? showcase_description[language.language_id].heading_title }}" class="form-control" placeholder="{{ entry_heading }}" />
                </div>
              </div>
            </div>
            {% endfor %}
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
// один глобальний перемикач мов на всю форму
(function () {
  var tabs = document.querySelectorAll('#language a[data-lang]');

  function show(language_id) {
    document.querySelectorAll('.js-lang').forEach(function (block) {
      block.hidden = !block.classList.contains('js-lang-' + language_id);
    });

    tabs.forEach(function (tab) {
      tab.parentNode.classList.toggle('active', tab.dataset.lang === language_id);
    });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function (event) {
      event.preventDefault();
      show(tab.dataset.lang);
    });
  });
})();

// поле ручного вибору товарів показуємо лише для типу "вручну"
$('#input-type').on('change', function () {
  $('#group-product').toggle($(this).val() == 'manual');
});

$('input[name=\'product_name\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'product_name\']').val('');

		$('#hp-showcase-product' + item['value']).remove();

		$('#hp-showcase-product').append('<div id="hp-showcase-product' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="product[]" value="' + item['value'] + '" /></div>');
	}
});

$('#hp-showcase-product').delegate('.fa-minus-circle', 'click', function() {
	$(this).parent().remove();
});
//--></script>
</div>
{{ footer }}
