<section class="product__related hp-cart-related">
    <div class="container">
        <div class="product__related-head">
            <h2 class="product__related-title">{{ heading_title }}</h2>
            <div class="product__related-btns">
                <button class="product__related-prev" aria-label="{{ text_prev }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#161616" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button class="product__related-next" aria-label="{{ text_next }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#161616" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>
        <div class="product__related-slider swiper">
            <div class="swiper-wrapper">
                {% for product in products %}
                <div class="swiper-slide">
                    <div class="product__item">
                        <div class="product__item-media">
                            <a class="product__item-image" href="{{ product.href }}">
                                <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" width="450" height="450">
                            </a>
                        </div>
                        <div class="product__item-content">
                            <a class="product__item-title" href="{{ product.href }}"><h3>{{ product.name }}</h3></a>
                            <p class="product__item-price">
                                {% if product.special %}<span class="product__item-price-new">{{ product.special }}</span> <span class="product__item-price-old">{{ product.price }}</span>{% else %}{{ product.price }}{% endif %}
                            </p>
                            <button class="product__item-add btn-2" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">
                                {{ button_cart }}
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.56706 2.90039H6.90039V6.90039L2.90039 6.90039V9.56706H6.90039V13.5671H9.56706V9.56706H13.5671V6.90039L9.56706 6.90039V2.90039Z" fill="white"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
<script src="catalog/view/theme/default/vendor/swiper-bundle.min.js"></script>
<script>
/* слайдер рекомендацій кошика — той самий вигляд, що на картці товару */
document.addEventListener('DOMContentLoaded', function () {
    var el = document.querySelector('.hp-cart-related .product__related-slider');
    if (!el || !window.Swiper || el.swiper) return;

    new Swiper(el, {
        spaceBetween: 24,
        slidesPerView: 1.15,   /* один крок з .hm-slider: картка 86% + край наступної */
        navigation: { nextEl: '.hp-cart-related .product__related-next', prevEl: '.hp-cart-related .product__related-prev' },
        breakpoints: { 768: { slidesPerView: 3 }, 1000: { slidesPerView: 4 } }
    });
});
</script>
