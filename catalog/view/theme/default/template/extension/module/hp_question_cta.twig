<section class="about-cta hp-qcta"><div class="container">
    <div class="dx-cta">
        <p class="dx-cta__name">{{ text_cta_name }}</p>
        <p class="dx-cta__text">{{ text_cta_text }}</p>
        <div class="dx-cta__row">
            {% if telephone %}<a class="dx-cta__phone" href="tel:{{ telephone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ telephone }}</a>{% endif %}
            <button type="button" class="btn-2" data-hp-modal-open="question" style="display:inline-flex;align-items:center;">{{ text_ask }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </button>
        </div>
    </div>
</div></section>
<div class="cdm qsm" data-hp-modal="question" hidden>
    <div class="cdm__overlay" data-hp-modal-close></div>
    <div class="cdm__dialog" role="dialog" aria-modal="true" aria-label="{{ text_q_title }}">
        <button type="button" class="cdm__close" data-hp-modal-close aria-label="{{ text_close|default('Закрити') }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
        <p class="cdm__title">{{ text_q_title }}</p>
        <p class="qsm__lead">{{ text_q_lead }}</p>

        <form class="qsm__form" data-hp-form="question"
              data-action="index.php?route=information/question/send"
              data-verify="1" data-reload="1" data-event="generate_lead"
              data-verify-title="{{ text_q_title }}">
            <input type="text" name="company_website" class="qsm__trap" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div class="account__field">
                <label for="q-name">{{ entry_q_name }}</label>
                <input type="text" id="q-name" name="name" value="{{ customer_firstname }}" placeholder="{{ ph_q_name|default('Як до вас звертатись') }}" required>
            </div>
            <div class="account__field">
                <label for="q-phone">{{ entry_q_phone }}</label>
                <input type="tel" id="q-phone" name="telephone" value="{{ customer_telephone }}" placeholder="{{ ph_q_phone }}" autocomplete="tel" required>
            </div>
            <div class="account__field">
                <label for="q-email">{{ entry_q_email }}</label>
                <input type="email" id="q-email" name="email" value="{{ customer_email }}" placeholder="{{ ph_q_email }}" autocomplete="email" required>
                {% if not logged %}
                {# гостю пошту підтверджуємо кодом уже після натискання «Надіслати» #}
                <p class="qsm__hint">{{ text_q_verify }}</p>
                {% endif %}
            </div>
            <div class="account__field">
                <label for="q-text">{{ entry_q_text }}</label>
                <textarea id="q-text" name="question" rows="4" placeholder="{{ ph_q_text|default('Опишіть, що хочете дізнатись') }}" required></textarea>
            </div>
            <p class="checkout__error" data-hp-error hidden></p>
            <button type="submit" class="btn-2 qsm__submit">{{ button_q_send }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
        </form>
    </div>
</div>
<script>
/* акордеони FAQ (перший відкритий). Поведінку самого попапа веде спільний
   рушій hp-form-modal.js — окремий скрипт на кожну форму більше не потрібен. */
(function () {
    document.querySelectorAll('.faq-page .hm-faq__btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var item = btn.parentNode;
            var open = item.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });
})();
</script>
