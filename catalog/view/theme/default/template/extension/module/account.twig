<nav class="account__nav" aria-label="{{ text_account }}">
  <p class="account__nav-title">{{ text_account }}</p>

  {% if not logged %}
  <a href="{{ login }}" class="account__nav-item">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg></span>
    {{ text_login }}
  </a>
  <a href="{{ register }}" class="account__nav-item">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg></span>
    {{ text_register }}
  </a>
  {% endif %}

  <a href="{{ account }}" class="account__nav-item">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
    {{ text_account }}
  </a>


  <a href="{{ address }}" class="account__nav-item">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
    {{ text_address }}
  </a>

  <a href="{{ order }}" class="account__nav-item">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg></span>
    {{ text_order }}
  </a>

  <a href="{{ wishlist }}" class="account__nav-item">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5.2 5.2 0 0 0-7.4 0l-1.4 1.4-1.4-1.4a5.2 5.2 0 1 0-7.4 7.4l8.8 8.8 8.8-8.8a5.2 5.2 0 0 0 0-7.4z"/></svg></span>
    {{ text_wishlist }}
  </a>



  {% if logged %}
  <a href="{{ logout }}" class="account__nav-item account__nav-item--logout">
    <span class="account__nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
    {{ text_logout }}
  </a>
  {% endif %}
</nav>
<script>
/* підсвічуємо поточний пункт навігації кабінету */
(function () {
    var here = location.href.split('?')[0];
    document.querySelectorAll('.account__nav-item').forEach(function (a) {
        var href = a.getAttribute('href') || '';
        if (!href) return;
        var base = href.split('?')[0];
        var route = href.indexOf('route=') > -1 ? href.split('route=')[1].split('&')[0] : '';
        var current = new URLSearchParams(location.search).get('route') || '';
        if (base === here || (route && route === current)) a.classList.add('is-active');
    });
})();
</script>
