{{ header }}
{% if ga_list %}
<script>
/* GA4: перегляд списку товарів розділу */
if (typeof gtag === 'function') { gtag('event', 'view_item_list', {{ ga_list|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}); }
</script>
{% endif %}
<main class="main">
        <section class="catalog" id="product-category">
            <div class="container" id="content">
                <div class="catalog__inner">

                    {% if breadcrumbs %}
                    <nav class="catalog__crumbs" aria-label="{{ text_breadcrumbs }}">
                        {% for breadcrumb in breadcrumbs %}
                        <a href="{{ breadcrumb.href }}" class="catalog__crumbs-link{% if loop.last %} is-current{% endif %}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span class="catalog__crumbs-sep" aria-hidden="true">/</span>{% endif %}
                        {% endfor %}
                    </nav>
                    <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for breadcrumb in breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ breadcrumb.text|json_encode }},"item":{{ breadcrumb.href|json_encode }}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
                    {% endif %}
{% for block in schema_blocks %}
<script type="application/ld+json">{{ block|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endfor %}

                    {# у корені каталогу надзаголовок і назва збігаються — дубль не показуємо #}
                    {# h1 — назва категорії, а надзаголовок «Каталог» лишається
                       текстом: інакше всі категорії мали однаковий заголовок #}
                    {% if heading_title|lower != brs_catalog|lower %}
                    <p class="catalog__title page-title">{{ brs_catalog }}</p>
                    <h1 class="catalog__name page-name">{{ heading_title }}</h1>
                    {% else %}
                    <h1 class="catalog__name page-name">{{ heading_title }}</h1>
                    {% endif %}

                    <div class="catalog__filters" data-legacy-filters>
                        <select name="categories" id="category-select">
                            <option value="" selected hidden>{{ text_category }}</option>
                            {% for category in category_options %}
                            <option value="{{ category.href }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>
                        <select id="input-sort" class="form-control" onchange="location = this.value;" aria-label="{{ text_sort|default('Сортування') }}">
                        {% for sort_option in sorts %}
                        {% if sort_option.value == '%s-%s'|format(sort, order) %}
                            <option value="{{ sort_option.href }}" selected="selected">{{ sort_option.text }}</option>
                            {% else %}
                            <option value="{{ sort_option.href }}">{{ sort_option.text }}</option>
                            {% endif %}
                            {% endfor %}
                        </select>
                        {% if price_floor is defined and price_ceil is defined %}
                        <form class="catalog__price" method="get" action="index.php" data-price-form>
                            <input type="hidden" name="route" value="product/category">
                            <input type="hidden" name="path" value="" data-price-path>
                            <span class="catalog__price-label">{{ text_price }}</span>
                            <input class="catalog__price-input" type="number" name="price_min" min="{{ price_floor }}" max="{{ price_ceil }}" value="{{ price_min_value|default('') }}" placeholder="{{ price_floor }}" aria-label="{{ text_price_from }}">
                            <span class="catalog__price-sep" aria-hidden="true">&ndash;</span>
                            <input class="catalog__price-input" type="number" name="price_max" min="{{ price_floor }}" max="{{ price_ceil }}" value="{{ price_max_value|default('') }}" placeholder="{{ price_ceil }}" aria-label="{{ text_price_to }}">
                            <button type="submit" class="catalog__price-submit" aria-label="{{ text_apply }}">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                            </button>
                        </form>
                        {% endif %}
                        <form class="catalog__search" method="get" action="index.php">
                            <input type="hidden" name="route" value="product/search">
                            <input class="catalog__search-input" type="text" name="search" placeholder="{{ text_search_catalog }}" aria-label="{{ text_search_catalog }}" autocomplete="off">
                            <button type="submit" class="catalog__search-btn" aria-label="{{ button_search }}">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                            </button>
                        </form>
                    </div>

                    {% if chips is defined and chips %}
                    <div class="catalog__chips">
                        {% for chip in chips %}
                        <a class="catalog__chip" href="{{ chip.href }}">{{ chip.text }}<span aria-hidden="true">&times;</span></a>
                        {% endfor %}
                        {% if chips_clear is defined %}<a href="{{ chips_clear }}" class="catalog__chips-clear">{{ text_clear_all }}</a>{% endif %}
                    </div>
                    {% endif %}

                    {% set has_aside = categories or category_options or description or popular %}

                    {% if has_aside %}
                    <button type="button" class="catalog__aside-toggle" data-aside-toggle>
                        {{ text_filters }}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    {% endif %}

                    <div class="catalog__body{% if not has_aside %} catalog__body--full{% endif %}">
                        {% if has_aside %}
                        <aside class="catalog__aside" data-aside>
                            {% if categories %}
                            <div class="catalog__filter">
                                <p class="catalog__filter-title">{{ text_categories }}</p>
                                <div class="catalog__filter-list">
                                    {% for category in categories %}
                                    <a href="{{ category.href }}" class="catalog__filter-item">{{ category.name }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                            {% endif %}
                            {% if category_options %}
                            <div class="catalog__filter">
                                <p class="catalog__filter-title">{{ text_sections }}</p>
                                <div class="catalog__filter-list">
                                    {% for category in category_options %}
                                    <a href="{{ category.href }}" class="catalog__filter-item">{{ category.name }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                            {% endif %}
                            {% if popular %}
                            <div class="catalog__filter">
                                <p class="catalog__filter-title">{{ text_popular }}</p>
                                <div class="cui-pop-list">
                                    {% for p in popular %}
                                    <a class="cui-pop" href="{{ p.href }}">
                                        <img class="cui-pop__img" src="{{ p.thumb }}" alt="{{ p.name }}" loading="lazy">
                                        <span class="cui-pop__meta">
                                            <span class="cui-pop__name">{{ p.name }}</span>
                                            <span class="cui-pop__price">{{ p.price }}</span>
                                        </span>
                                    </a>
                                    {% endfor %}
                                </div>
                            </div>
                            {% endif %}
                            
                            
                            {% if filter_groups %}
                            <form class="catalog__filter hpf-form" method="get" action="{{ filter_action }}" data-seo-base="{{ filter_seo_base|default('') }}" data-filter-form>
                                <input type="hidden" name="path" value="{{ path_value|default('') }}">
                                {% for filter_group in filter_groups %}
                                {% set has_checked = false %}
                                {% for filter in filter_group.filter %}{% if filter.selected %}{% set has_checked = true %}{% endif %}{% endfor %}
                                <div class="hpf is-open" data-hpf>
                                    <button type="button" class="hpf__toggle" data-hpf-toggle aria-expanded="true">{{ filter_group.name }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                                    </button>
                                    <div class="hpf__body">
                                        {% for filter in filter_group.filter %}
                                        <label class="hpf__item">
                                            <input type="checkbox" class="hpf__check" name="filter[]" value="{{ filter.filter_id }}" data-slug="{{ filter.slug|default('') }}" data-autosubmit{% if filter.selected %} checked{% endif %}>
                                            <span class="hpf__box" aria-hidden="true"></span>
                                            <span class="hpf__label">{{ filter.name }} <span class="hpf__count">({{ filter.total }})</span></span>
                                        </label>
                                        {% endfor %}
                                    </div>
                                </div>
                                {% endfor %}
                                {% if filter_selected_count %}
                                <div class="hpf__actions">
                                    <noscript><button type="submit" class="btn-2">{{ text_apply }}</button></noscript>
                                    <a href="{{ filter_action }}" class="hpf__reset">{{ text_reset }} ({{ filter_selected_count }})</a>
                                </div>
                                {% else %}
                                <noscript><div class="hpf__actions"><button type="submit" class="btn-2">{{ text_apply }}</button></div></noscript>
                                {% endif %}
                            </form>
                            {% endif %}
                        </aside>
                        {% endif %}

                        <div class="catalog__main">
                           {% if products %}
                           <div class="catalog__content" id="product-list">
                           {% for product in products %}
                                <div class="product__item">
                                    <div class="product__item-media">
                                        <a class="product__item-image" href="{{ product.href }}">
                                            <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" width="450" height="450">
                                        </a>
                                        {% if product.special or (product.badges is defined and product.badges) %}
                                        <div class="product__item-badges">
                                            {% if product.special %}<span class="product__item-badge product__item-badge--sale">{{ text_badge_sale }}</span>{% endif %}
                                            {% if product.badges is defined %}
                                            {% for badge in product.badges %}
                                            {% if badge == 'new' %}<span class="product__item-badge product__item-badge--new">{{ text_badge_new }}</span>{% endif %}
                                            {% if badge == 'top' %}<span class="product__item-badge product__item-badge--top">{{ text_badge_top }}</span>{% endif %}
                                            {% endfor %}
                                            {% endif %}
                                        </div>
                                        {% endif %}
                                        <button type="button" class="product__item-wish" data-wishlist="{{ product.product_id }}" title="{{ text_wishlist_add }}" aria-label="{{ text_wishlist_add }}" onclick="wishlist.add('{{ product.product_id }}');">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 5.6a5.2 5.2 0 0 0-7.4 0l-1.4 1.4-1.4-1.4a5.2 5.2 0 1 0-7.4 7.4l8.8 8.8 8.8-8.8a5.2 5.2 0 0 0 0-7.4z"/></svg>
                                        </button>
                                    </div>
                                    <div class="product__item-content">
                                        <a class="product__item-title" href="{{ product.href }}">
                                            <h3>{{ product.name }}</h3>
                                        </a>
                                        {% if product.rating %}
                                        <div class="product__item-rating" role="img" aria-label="{{ text_rating|format(product.rating) }}">
                                            {% for i in 1..5 %}
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="product__item-star{% if i <= product.rating %} is-active{% endif %}"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                                            {% endfor %}
                                        </div>
                                        {% endif %}
                                        <p class="product__item-price">
                                            {% if product.special %}
                                            <span class="product__item-price-new">{{ product.special }}</span> <span class="product__item-price-old">{{ product.price }}</span>
                                            {% else %}
                                            {{ product.price }}
                                            {% endif %}
                                        </p>
                                        <button class="product__item-add btn-2" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">
                                            {{ button_cart }}
                                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.56706 2.90039H6.90039V6.90039L2.90039 6.90039V9.56706H6.90039V13.5671H9.56706V9.56706H13.5671V6.90039L9.56706 6.90039V2.90039Z" fill="white"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            {% if loop.index % 8 == 0 and banners[loop.index // 8 - 1] is defined %}
                            {% set b = banners[loop.index // 8 - 1] %}
                            <a class="catalog__banner" href="{{ b.href }}">
                                <div class="catalog__banner-media"><img src="{{ b.img }}" alt="" loading="lazy"></div>
                                <div class="catalog__banner-body">
                                    <p class="catalog__banner-title">{{ b.title }}</p>
                                    <p class="catalog__banner-text">{{ b.text }}</p>
                                    <span class="catalog__banner-btn btn-2">{{ b.btn }}
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                    </span>
                                </div>
                            </a>
                            {% endif %}
                            {% endfor %}
                            </div>
                            {% endif %}
                            {% if not categories and not products %}
                            <p>{{ text_empty }}</p>
                            <div class="buttons">
                                <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% if products and pagination %}
                    <div id="json-pagination">
                        {{ pagination }}
                        <p class="cui-results">{{ results }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </section>

        {% if description %}
        <section class="seo-desc seo-desc--category"><div class="container">
            <h2 class="seo-desc__title">{{ text_about_category }}</h2>
            <div class="desc is-collapsible" data-cat-desc-text>{{ description }}</div>
            <button type="button" class="desc-toggle" data-desc-toggle data-more="{{ text_show_more|default('Показати більше') }}" data-less="{{ text_show_less|default('Згорнути') }}"><span>{{ text_show_more|default('Показати більше') }}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
        </div></section>
        <script>
        /* розгортання опису категорії; кнопка ховається, якщо все вміщається */
        (function () {
            var desc = document.querySelector('[data-cat-desc-text]');
            var btn = desc ? desc.parentNode.querySelector('[data-desc-toggle]') : null;
            if (!desc || !btn) return;

            function sync() {
                if (desc.classList.contains('is-open')) return;
                btn.hidden = desc.scrollHeight <= desc.clientHeight + 4;
            }

            btn.addEventListener('click', function () {
                var open = desc.classList.toggle('is-open');
                btn.classList.toggle('is-open', open);
                btn.querySelector('span').textContent = open ? btn.getAttribute('data-less') : btn.getAttribute('data-more');
                if (!open) desc.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            window.addEventListener('load', sync);
            sync();
        })();
        </script>
        {% endif %}

<div class="hm-light">
{{ content_bottom }}
</div>
</main>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var categorySelect = document.getElementById('category-select');
    if (categorySelect) {
        categorySelect.addEventListener('change', function () {
            if (this.value) {
                window.location.href = this.value;
            }
        });
    }

    document.querySelectorAll('[data-desc]').forEach(function (box) {
        var scroll = box.querySelector('[data-desc-scroll]');
        var toggle = box.querySelector('[data-desc-toggle]');
        var label = toggle ? toggle.querySelector('[data-desc-text]') : null;
        if (!scroll || !toggle) {
            return;
        }
        if (scroll.scrollHeight > scroll.clientHeight + 4) {
            toggle.hidden = false;
        }
        toggle.addEventListener('click', function () {
            var expanded = box.classList.toggle('is-expanded');
            if (label) {
                label.textContent = expanded ? '{{ text_less }}' : '{{ text_more }}';
            }
        });
    });

    var asideToggle = document.querySelector('[data-aside-toggle]');
    var aside = document.querySelector('[data-aside]');
    if (asideToggle && aside) {
        asideToggle.addEventListener('click', function () {
            aside.classList.toggle('is-open');
        });
    }

    var priceForm = document.querySelector('[data-price-form]');
    if (priceForm) {
        var pathField = priceForm.querySelector('[data-price-path]');
        var params = new URLSearchParams(window.location.search);
        if (pathField && params.get('path')) {
            pathField.value = params.get('path');
        }
    }
});
</script>
<script>
window.hpCatalogText = {
    filters: {{ text_filters|json_encode|raw }},
    close: {{ text_close|default('Закрити')|json_encode|raw }},
    grid4: {{ text_grid4|default('По чотири')|json_encode|raw }},
    grid2: {{ text_grid2|default('По два')|json_encode|raw }}
};
</script>
<script src="catalog/view/theme/default/js/catalog-ui.js?v=20260901" type="text/javascript"></script>
{{ footer }}
