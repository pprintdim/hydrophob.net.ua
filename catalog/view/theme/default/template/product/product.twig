            <input type="hidden" name="product_id" value="{{ product_id }}">
            {# кількість і опції беремо з форми товару в момент відкриття #}
            <input type="hidden" name="quantity" value="1" data-qo-qty-field>
            <span data-qo-options></span>

            <div class="account__field">
                <label for="qo-name">{{ entry_quick_name }}</label>
                <input type="text" id="qo-name" name="firstname" placeholder="{{ entry_quick_name }}" autocomplete="name" required>
                <em class="account__field-error" data-hp-error-for="firstname" hidden></em>
            </div>
            <div class="account__field">
                <label for="qo-phone">{{ entry_quick_phone }}</label>
                <input type="tel" id="qo-phone" name="telephone" placeholder="50 123 4567" autocomplete="tel" required>
                <em class="account__field-error" data-hp-error-for="telephone" hidden></em>
            </div>
            <div class="account__field">
                <label for="qo-email">{{ entry_quick_email }}</label>
                <input type="email" id="qo-email" name="email" placeholder="you@example.com" autocomplete="email">
                <em class="account__field-error" data-hp-error-for="email" hidden></em>
            </div>
            <div class="account__field">
                <label for="qo-comment">{{ entry_quick_comment }}</label>
                <textarea id="qo-comment" name="comment" rows="2" placeholder="{{ text_quick_note }}"></textarea>
            </div>

            <p class="checkout__error" data-hp-error hidden></p>

            <button type="submit" class="btn-2 qsm__submit">{{ button_quick_send }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
        </form>
    </div>
</div>

<script>
/* Єдиний рушій попапів веде відкриття, валідацію й відправку. Тут лишається
   тільки те, що унікальне для швидкого замовлення: підтягнути з картки
   товару кількість, поточну ціну й обрані опції. */
(function () {
    var modal = document.getElementById('quick-order');
    if (!modal) return;

    modal.addEventListener('hp-modal-open', function () {
        var productForm = document.getElementById('product');
        var qty = productForm ? productForm.querySelector('input[name="quantity"]') : null;
        var qtyValue = qty && qty.value ? qty.value : '1';

        var qtyOut = modal.querySelector('[data-qo-qty]');
        if (qtyOut) qtyOut.textContent = qtyValue;

        var qtyField = modal.querySelector('[data-qo-qty-field]');
        if (qtyField) qtyField.value = qtyValue;

        var priceBox = document.getElementById('dynamic-price');
        var priceOut = modal.querySelector('[data-qo-price]');
        if (priceBox && priceOut) priceOut.textContent = priceBox.textContent.trim();

        // обрані опції — прихованими полями, щоб пішли звичайним POST
        var box = modal.querySelector('[data-qo-options]');
        if (!box) return;

        box.innerHTML = '';

        if (!productForm) return;

        productForm.querySelectorAll('[name^="option"]').forEach(function (el) {
            if ((el.type === 'radio' || el.type === 'checkbox') && !el.checked) return;

            var hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = el.name;
            hidden.value = el.value;
            box.appendChild(hidden);
        });
    });
})();
</script>


<script>
/* Історія переглядів для модуля «Переглянуті нещодавно»: тримаємо до 12
   останніх id у localStorage, поточний товар — на початку списку. */
(function () {
    var current = {{ product_id }};

    try {
        var viewed = JSON.parse(localStorage.getItem('hydro_viewed') || '[]');
        var next = [current].concat(viewed.filter(function (id) { return parseInt(id, 10) !== current; })).slice(0, 12);

        localStorage.setItem('hydro_viewed', JSON.stringify(next));
    } catch (e) {}
})();
</script>

