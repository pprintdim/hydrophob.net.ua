<script type="text/javascript">
function addToCart() {
    const btn = document.getElementById('button-cart');
    if (btn && btn.disabled) return;

    const quantity = parseInt(document.querySelector('input[name="quantity"]').value) || 1;
    const optionInputs = document.querySelectorAll('select[name^="option"]');

    // Собираем опции в правильном виде
    const options = {};
    optionInputs.forEach(el => {
        // Имя должно быть только ID опции
        const option_id = el.name.match(/\d+/)[0]; 
        options[option_id] = el.value;
    });

    // Формируем данные для AJAX
    const data = {
        product_id: product_id,
        quantity: quantity,
        option: options
    };

    // Єдиний шлях додавання: cart.add із script.js — шухляда, бейдж,
    // напис «В кошику» і стандартний тост. Без алертів і скролу вгору.
    window.cart.add(product_id, quantity, options);
}


</script> 



