{# Швидке замовлення: імʼя + телефон, решту менеджер уточнює дзвінком #}
<div class="cdm qo" data-hp-modal="quick" id="quick-order" hidden>
    <div class="cdm__overlay" data-hp-modal-close></div>
    <div class="cdm__dialog" role="dialog" aria-modal="true" aria-labelledby="qo-title">
