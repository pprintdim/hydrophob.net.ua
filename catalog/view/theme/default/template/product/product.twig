<script>
document.addEventListener('DOMContentLoaded', function () {
    const priceBox = document.getElementById('dynamic-price');
    const productForm = document.querySelector('#product');
    const quantityInput = productForm.querySelector('input[name="quantity"]');
    const optionInputs = productForm.querySelectorAll('[name^="option"]');

    const minusBtn = document.querySelector('.product__count-minus');
    const plusBtn = document.querySelector('.product__count-plus');

    function updatePrice() {
        const fd = new FormData();
        fd.append('quantity', quantityInput.value);

        optionInputs.forEach(el => {
            if (el.type === 'radio' && !el.checked) return;
            fd.append(el.name, el.value);
        });

        fetch('index.php?route=product/product/updatePrice&product_id=' + product_id, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(json => {
            if (json.price) priceBox.innerHTML = json.price;
        })
        .catch(err => console.error(err));
    }

    if (minusBtn) minusBtn.addEventListener('click', () => {
        let val = parseInt(quantityInput.value) || 1;
        if (val > 1) {
            quantityInput.value = val - 1;
            updatePrice();
        }
    });

    if (plusBtn) plusBtn.addEventListener('click', () => {
        let val = parseInt(quantityInput.value) || 1;
        if (val < 999) {
            quantityInput.value = val + 1;
            updatePrice();
        }
    });

    quantityInput.addEventListener('input', () => {
        let val = parseInt(quantityInput.value) || 1;
        if (val < 1) val = 1;
        if (val > 999) val = 999;
        quantityInput.value = val;
        updatePrice();
    });

    optionInputs.forEach(el => el.addEventListener('change', updatePrice));
});

/* згортання довгого опису товару (скрипт стоїть вище вкладок — чекаємо DOM) */
document.addEventListener('DOMContentLoaded', function () {
    var desc = document.querySelector('[data-product-desc]');
    var btn = document.querySelector('[data-desc-toggle]');
    if (!desc || !btn) return;

    // короткий опис ховати нема сенсу — прибираємо кнопку
    function syncToggle() {
        if (desc.classList.contains('is-open')) return;
        var fits = desc.scrollHeight <= desc.clientHeight + 4;
        btn.hidden = fits;
        desc.classList.toggle('is-collapsible', !fits);
    }

    syncToggle();
    window.addEventListener('resize', syncToggle);
    btn.addEventListener('click', function () {
        var open = desc.classList.toggle('is-open');
        btn.classList.toggle('is-open', open);
        btn.querySelector('span').textContent = open ? btn.getAttribute('data-less') : btn.getAttribute('data-more');
        if (!open) desc.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});

/* Якщо товар уже в кошику — лічильник на сторінці керує кількістю саме цієї
   позиції: показуємо поточну кількість і оновлюємо її при зміні. */
(function () {
    var form = document.getElementById('product');
    if (!form) return;

    var input = form.querySelector('input[name="quantity"]');
    var btn = document.getElementById('button-cart');
    if (!input || !btn) return;

    var timer = null;
    var pushing = false;

    function entry() {
        return (window.hpCartItems || {})[String(product_id)] || null;
    }

    function syncFromCart() {
        var item = entry();
        if (!item || pushing) return;
        if (parseInt(input.value, 10) !== item.quantity) input.value = item.quantity;
    }

    function pushQuantity() {
        var item = entry();
        if (!item) return;                       // товару в кошику немає — нічого не оновлюємо

        var val = parseInt(input.value, 10);
        if (isNaN(val) || val < 1) val = 1;

        pushing = true;
        btn.classList.add('is-syncing');

        fetch('index.php?route=checkout/cart/edit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'key=' + encodeURIComponent(item.key) + '&quantity=' + val
        })
        .then(function () {
            item.quantity = val;
            if (window.jQuery) $('#cart > ul').load('index.php?route=common/cart/info ul li');
            // hp-cart-changed → syncAll → перерахунок бейджа й мапи кошика
            document.dispatchEvent(new CustomEvent('hp-cart-changed'));
        })
        .catch(function () {})
        .then(function () {
            pushing = false;
            btn.classList.remove('is-syncing');
        });
    }

    ['click'].forEach(function (evt) {
        var minus = form.querySelector('.product__count-minus');
        var plus = form.querySelector('.product__count-plus');
        if (minus) minus.addEventListener(evt, function () { clearTimeout(timer); timer = setTimeout(pushQuantity, 350); });
        if (plus) plus.addEventListener(evt, function () { clearTimeout(timer); timer = setTimeout(pushQuantity, 350); });
    });

    input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(pushQuantity, 700);
    });

    document.addEventListener('hp-cart-synced', syncFromCart);
})();

function addToCart() {
    const btn = document.getElementById('button-cart');
    if (btn && btn.disabled) return;

    const quantity = parseInt(document.querySelector('input[name="quantity"]').value) || 1;

    const optionInputs = document.querySelectorAll('#product [name^="option"]');
    const options = {};

    optionInputs.forEach(el => {
        if (el.type === 'radio' && !el.checked) return;
        options[el.name.replace('option[','').replace(']','')] = el.value;
    });

    cart.add(product_id, quantity, options);
}

</script>								
