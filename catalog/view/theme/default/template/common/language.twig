{% if languages|length > 1 %}
{% set lang_map = {'uk-ua':'UA', 'ru-ru':'RU', 'en-gb':'EN'} %}
<div class="header__lang">
    <div class="header__lang-selected">
        {% for language in languages %}
            {% if language.code == code %}
                {{ lang_map[language.code] }}
            {% endif %}
        {% endfor %}
    </div>
    <div class="header__lang-content">
        {% for language in languages %}
            {% if language.code != code %}
                <a href="#" class="language-select" data-code="{{ language.code }}">
                    {{ lang_map[language.code] }}
                </a>
            {% endif %}
        {% endfor %}
    </div>
    <form action="{{ action }}" method="post" id="form-language">
        <input type="hidden" name="code" value="" />
        <input type="hidden" name="redirect" value="{{ redirect }}" />
    </form>
</div>

<script>
document.querySelectorAll('.header__lang-content .language-select').forEach(function(el) {
    el.addEventListener('click', function(e) {
        e.preventDefault();
        var code = this.getAttribute('data-code');
        var form = document.getElementById('form-language');
        form.querySelector('input[name="code"]').value = code;
        form.submit();
    });
});
</script>
{% endif %}
