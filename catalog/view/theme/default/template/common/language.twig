{% if languages|length > 1 %}
{% set lang_map = {'uk-ua':'UA', 'ru-ru':'RU', 'en-gb':'EN'} %}
<div class="header__lang">
    <div class="header__lang-selected">
        {% for language in languages %}
            {% if language.code == code %}
                {{ lang_map[language.code] }}
            {% endif %}
        {% endfor %}
    </div>
    <div class="header__lang-content">
        {% for language in languages %}
            {% if language.code != code %}
                {# мова живе в адресі, тож це звичайне посилання: боти бачать
                   зв'язок між версіями, а користувач лишається на тій самій сторінці #}
                <a href="{{ language.href }}" class="language-select" hreflang="{{ language.code[:2] }}">
                    {{ lang_map[language.code] }}
                </a>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endif %}
