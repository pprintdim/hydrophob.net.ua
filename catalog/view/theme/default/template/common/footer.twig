};
</script>

{# Модалка відгуку: на картці товару товар уже відомий, на /vidhuky його обирають автокомплітом #}
<div class="rvm" id="review-modal" aria-hidden="true">
    <div class="rvm__overlay" data-review-close></div>
    <div class="rvm__box" role="dialog" aria-modal="true" aria-labelledby="rvm-title">
        <button type="button" class="rvm__close" data-review-close aria-label="{{ text_quick_close|default('Закрити') }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>

        <p class="rvm__title" id="rvm-title">{{ text_review_title }}</p>

        <form class="rvm__form" data-review-form>
            <div class="rvm__field" data-review-product-field hidden>
                <span class="rvm__label">{{ text_review_product }}</span>
                <div class="rvm__search">
                    <input type="text" class="rvm__input" placeholder="{{ text_review_product_ph }}" autocomplete="off" data-review-search>
                    <div class="rvm__results" data-review-results hidden></div>
                </div>
                <div class="rvm__picked qo__product" data-review-picked hidden>
                    <img class="qo__product-img" src="" alt="" width="72" height="72" data-review-picked-img>
                    <span class="qo__product-name" data-review-picked-name></span>
                    <button type="button" class="rvm__picked-clear" data-review-picked-clear aria-label="×">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
                    </button>
                </div>
            </div>

            <div class="rvm__field">
                <span class="rvm__label">{{ text_review_rating }}</span>
                <div class="rvm__stars" data-review-stars>
                    {% for i in 1..5 %}
                    <button type="button" class="rvm__star" data-value="{{ i }}" aria-label="{{ i }}/5">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.3 6.2 20.3l1.1-6.4L2.6 9.3l6.5-.9z"/></svg>
                    </button>
                    {% endfor %}
                </div>
            </div>

            <div class="account__field">
                <label for="rvm-name">{{ text_review_name }}</label>
                <input type="text" id="rvm-name" name="name" autocomplete="name" required>
                <em class="account__field-error" data-hp-error-for="name" hidden></em>
            </div>

            <div class="account__field">
                <label for="rvm-phone">{{ text_review_phone }}</label>
                <input type="tel" id="rvm-phone" name="telephone" autocomplete="tel" required>
                <em class="account__field-error" data-hp-error-for="telephone" hidden></em>
            </div>

            <div class="account__field">
                <label for="rvm-email">{{ text_review_email }}</label>
                <input type="email" id="rvm-email" name="email" autocomplete="email" required>
                <em class="account__field-error" data-hp-error-for="email" hidden></em>
                {% if not hp_customer.email %}
                <p class="qsm__hint">{{ text_review_verify|default('Пошту підтвердимо кодом після натискання «Надіслати». Якщо акаунта ще немає — створимо його автоматично.') }}</p>
                {% endif %}
            </div>

            <div class="account__field">
                <label for="rvm-text">{{ text_review_text }}</label>
                <textarea id="rvm-text" name="text" rows="4" required></textarea>
            </div>

            <p class="rvm__error" data-review-error hidden></p>

            <button type="submit" class="btn-2 rvm__submit">{{ text_review_send }}</button>
        </form>

        <div class="rvm__done" hidden>
            <span class="rvm__done-icon"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <p>{{ text_review_thanks }}</p>
            <button type="button" class="btn-2" data-review-close>{{ text_quick_close|default('Закрити') }}</button>
        </div>
    </div>
</div>

<script>
window.hpReviewText = {
    title: {{ text_review_title|json_encode|raw }},
    pick: {{ text_review_pick|json_encode|raw }},
    searchUrl: {{ review_search_url|json_encode|raw }},
    action: {{ review_action|json_encode|raw }}
};
</script>
<script src="catalog/view/theme/default/js/review-modal.js?v=20260906b" defer></script>
<script src="catalog/view/theme/default/vendor/intlTelInput.min.js" defer></script>
<script src="catalog/view/theme/default/js/phone-input.js?v=20260905b" defer></script>
<script src="catalog/view/theme/default/js/otp.js?v=20260905a" type="text/javascript" defer></script>
<script src="catalog/view/theme/default/js/hp-form-modal.js?v=20260905a" defer></script>

{# Єдиний попап успіху для всіх форм сайту: розмітка одна, текст підставляє форма #}
<div class="cdm okm" data-ok-modal hidden>
    <div class="cdm__overlay" data-ok-close></div>
    <div class="cdm__dialog okm__dialog" role="dialog" aria-modal="true" aria-live="polite">
        <button type="button" class="cdm__close" data-ok-close aria-label="{{ text_close|default('Закрити') }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
        <span class="okm__icon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <p class="okm__title" data-ok-title></p>
        <p class="okm__text" data-ok-text></p>
        <button type="button" class="btn-2 okm__btn" data-ok-close>{{ text_ok_close|default('Зрозуміло') }}</button>
    </div>
</div>
<script>
/* window.hpSuccess(текст, заголовок) — один вигляд успіху на всі форми.
   Якщо форма перезавантажує сторінку (реєстрація/вхід), текст їде через
   sessionStorage і попап показується вже після редіректу. */
(function () {
    var modal = document.querySelector('[data-ok-modal]');
    if (!modal) return;

    var titleEl = modal.querySelector('[data-ok-title]');
    var textEl = modal.querySelector('[data-ok-text]');

    function close() {
        modal.hidden = true;
        document.body.classList.remove('no-scroll');
    }

    window.hpSuccess = function (text, title) {
        titleEl.textContent = title || {{ text_ok_title|default('Готово')|json_encode|raw }};
        textEl.textContent = text || '';
        modal.hidden = false;
        document.body.classList.add('no-scroll');
    };

    // показати після редіректу
    window.hpSuccessAfterReload = function (text, title) {
        try {
            sessionStorage.setItem('hp_success', JSON.stringify({ text: text || '', title: title || '' }));
        } catch (e) {}
    };

    modal.querySelectorAll('[data-ok-close]').forEach(function (el) { el.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });

    try {
        var stored = sessionStorage.getItem('hp_success');

        if (stored) {
            sessionStorage.removeItem('hp_success');

            var data = JSON.parse(stored);
            window.hpSuccess(data.text, data.title);
        }
    } catch (e) {}
})();
</script>

</body></html>
