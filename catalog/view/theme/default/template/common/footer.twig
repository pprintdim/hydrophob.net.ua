<script>
/* Leaflet важить разом із тайлами ~200 КБ і тягнеться зі сторонніх доменів,
   тому вантажимо його лише коли карта справді доїхала до екрана.
   Хелпер спільний: ним користуються і футер, і сторінка контактів. */
window.hpLeaflet = (function () {
    var state = 'idle';
    var queue = [];

    function run() {
        state = 'ready';
        queue.splice(0).forEach(function (cb) { cb(); });
    }

    return function (cb) {
        if (window.L) return cb();

        queue.push(cb);

        if (state !== 'idle') return;
        state = 'loading';

        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);

        var js = document.createElement('script');
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        js.onload = run;
        document.body.appendChild(js);
    };
})();

/* спостерігач: викликає колбек, коли елемент майже доїхав до екрана */
window.hpWhenVisible = function (el, cb) {
    if (!('IntersectionObserver' in window)) {
        window.addEventListener('load', cb);

        return;
    }

    var io = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;

        io.disconnect();
        cb();
    }, { rootMargin: '200px' });

    io.observe(el);
};

(function () {
    var el = document.getElementById('footer-map');
    if (!el) return;

    var lat = parseFloat(el.getAttribute('data-lat'));
    var lng = parseFloat(el.getAttribute('data-lng'));
    if (isNaN(lat) || isNaN(lng)) return;

    var started = false;

    function draw() {
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lng], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

        var gmaps = 'https://www.google.com/maps/search/?api=1&query=' + lat + ',' + lng;

        // маркер у фірмовому зеленому — стандартний синій PNG Leaflet не в стилі
        var pin = L.divIcon({
            className: 'hp-map-pin',
            html: '<svg width="34" height="44" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.4 0 0 5.4 0 12c0 8.4 12 20 12 20s12-11.6 12-20c0-6.6-5.4-12-12-12z" fill="#A7C70E"/><circle cx="12" cy="12" r="4.4" fill="#ffffff"/></svg>',
            iconSize: [34, 44],
            iconAnchor: [17, 44]
        });

        var marker = L.marker([lat, lng], { icon: pin })
            .addTo(map)
            .on('click', function () { window.open(gmaps, '_blank', 'noopener'); });

        // при наведенні показуємо адресу магазину
        var address = (el.getAttribute('data-address') || el.getAttribute('data-title') || '').trim();

        if (address) {
            marker.bindTooltip(address, { direction: 'top', offset: [0, -38], className: 'hp-map-tip' });
        }
    }

    window.hpWhenVisible(el, function () {
        if (started) return;
        started = true;

        window.hpLeaflet(draw);
    });
})();
</script>
