window.hpCartText = { inCart: {{ text_in_cart|default('В кошику')|json_encode|raw }}, addToCart: {{ button_cart|default('Додати в кошик')|json_encode|raw }}, addedToast: {{ text_added_toast|default('Товар додано в кошик')|json_encode|raw }} };
window.hpOtpText = {
    sending: {{ otp_sending|json_encode|raw }},
    resend: {{ otp_resend|json_encode|raw }},
    resendIn: {{ otp_resend_in|json_encode|raw }},
