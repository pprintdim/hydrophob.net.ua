                                <path d="M0 15C0 14.4477 0.447715 14 1 14H23C23.5523 14 24 14.4477 24 15C24 15.5523 23.5523 16 23 16H1C0.447716 16 0 15.5523 0 15Z" fill="white"/>
                              </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>