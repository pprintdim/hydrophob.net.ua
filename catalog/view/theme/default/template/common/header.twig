                                <path d="M0 8C0 7.44772 0.447715 7 1 7H23C23.5523 7 24 7.44772 24 8C24 8.55228 23.5523 9 23 9H1C0.447716 9 0 8.55228 0 8Z" fill="white"/>
                                <path d="M0 8C0 7.44772 0.447715 7 1 7H23C23.5523 7 24 7.44772 24 8C24 8.55228 23.5523 9 23 9H1C0.447716 9 0 8.55228 0 8Z" fill="white"/>
