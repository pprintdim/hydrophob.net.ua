{{ header }}
{% if ga_cart %}
<script>
/* GA4: перегляд кошика */
if (typeof gtag === 'function') { gtag('event', 'view_cart', {{ ga_cart|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}); }
</script>
{% endif %}
<main class="main main--light" id="content">
  <section class="checkout">
    <div class="container">
      {% if breadcrumbs %}
      <nav class="catalog__crumbs" aria-label="Breadcrumbs">
        {% for breadcrumb in breadcrumbs %}
        <a href="{{ breadcrumb.href }}" class="catalog__crumbs-link{% if loop.last %} is-current{% endif %}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span class="catalog__crumbs-sep" aria-hidden="true">/</span>{% endif %}
        {% endfor %}
      </nav>
      {% endif %}

      <h1 class="checkout__title page-name" style="color:#161616;">{{ heading_title }}</h1>

      {% if attention %}
      <div class="hp-toast hp-toast--ok" data-toast>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{{ attention }}</span>
        <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
      {% endif %}
              {% if success %}
        <div class="hp-toast hp-toast--ok" data-toast>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{{ success }}</span>
            <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>
        {% endif %}

              {% if error_warning %}
        <div class="hp-toast hp-toast--error" data-toast>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 17h.01"/></svg>
            <span>{{ error_warning }}</span>
            <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>
        {% endif %}


      {% if products or vouchers %}
      <div class="checkout__inner">
        <div class="checkout__content">
          <form action="{{ action }}" method="post" enctype="multipart/form-data" class="checkout__block">
            <div class="cart-list">
              {% for product in products %}
              <div class="cart-item">
                <a class="cart-item__image" href="{{ product.href }}">
                  {% if product.thumb %}<img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">{% endif %}
                </a>
                <div class="cart-item__body">
                  <a class="cart-item__name" href="{{ product.href }}">{{ product.name }}</a>
                  {% if not product.stock %}<span class="cart-item__stock">{{ text_stock_warning|default('***') }}</span>{% endif %}
                  {% if product.option %}
                  <ul class="cart-item__options">
                    {% for option in product.option %}<li>{{ option.name }}: {{ option.value }}</li>{% endfor %}
                  </ul>
                  {% endif %}
                  {% if product.recurring %}<p class="cart-item__recurring">{{ text_recurring_item }} {{ product.recurring }}</p>{% endif %}
                </div>
                <div class="cart-item__qty">
                  <div class="product__count cart-item__count" data-cart-qty="{{ product.cart_id }}">
                    <button class="product__count-minus" type="button" aria-label="&minus;"></button>
                    <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" class="cart-item__qty-input" inputmode="numeric" aria-label="{{ column_quantity }}" />
                    <button class="product__count-plus" type="button" aria-label="+"></button>
                  </div>
                  <button type="button" class="cart-item__remove" title="{{ button_remove }}" aria-label="{{ button_remove }}" data-cart-remove="{{ product.cart_id }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
                  </button>
                </div>
                <div class="cart-item__price">
                  <span class="cart-item__price-unit">{{ product.price }}</span>
                  <span class="cart-item__price-total">{{ product.total }}</span>
                </div>
              </div>
              {% endfor %}

              {% for voucher in vouchers %}
              <div class="cart-item cart-item--voucher">
                <div class="cart-item__body"><span class="cart-item__name">{{ voucher.description }}</span></div>
                <div class="cart-item__qty">
                  <button type="button" class="cart-item__remove" title="{{ button_remove }}" onclick="voucher.remove('{{ voucher.key }}');">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
                  </button>
                </div>
                <div class="cart-item__price"><span class="cart-item__price-total">{{ voucher.amount }}</span></div>
              </div>
              {% endfor %}
            </div>
          </form>

        </div>

        <aside class="checkout__busket busket-static">
          <div class="busket__top">
            <p class="busket__title">{{ text_summary|default(heading_title) }}</p>
          </div>

          <div class="busket__totals">
            {% for total in totals %}
            <div class="busket__total-row{% if loop.last %} busket__total-row--final{% endif %}">
              <span>{{ total.title }}</span>
              <b>{{ total.text }}</b>
            </div>
            {% endfor %}
          </div>

          <div class="busket__actions">
            <a href="{{ checkout }}" class="btn-2 busket__checkout">{{ button_checkout }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="{{ continue }}" class="busket__continue">{{ button_shopping }}</a>
          </div>

          <ul class="busket__perks">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3M20 17h2v-6l-3-5h-5v11h3"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
              {{ text_perk_delivery|default('Доставка Новою поштою по всій Україні') }}
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
              {{ text_perk_payment|default('Оплата карткою або при отриманні') }}
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
              {{ text_perk_return|default('Обмін і повернення протягом 14 днів') }}
            </li>
          </ul>

          <p class="busket__help">
            {{ text_need_help|default('Потрібна допомога?') }}
            <a href="tel:{{ store_phone|default('+380731081212') }}">{{ store_phone|default('+380 (73) 108-12-12') }}</a>
          </p>
        </aside>
      </div>
      {% else %}
      <div class="checkout__empty">
        <span class="checkout__empty-icon" aria-hidden="true">
          <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </span>
        <p class="checkout__empty-title">{{ text_empty }}</p>
        <p class="checkout__empty-text">{{ text_empty_hint|default('Оберіть засіб у каталозі — підкажемо, що підійде для авто, одягу чи дому.') }}</p>
        <a href="{{ continue }}" class="btn-2">{{ button_continue }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <ul class="checkout__empty-links">
          <li><a href="/nano-ceramic">{{ brs_nano_ceramic|default('Нанокераміка') }}</a></li>
          <li><a href="/car-protection">{{ brs_car_protection|default('Захист авто') }}</a></li>
          <li><a href="/textile">{{ brs_textile_protection|default('Захист одягу') }}</a></li>
        </ul>
      </div>
      {% endif %}
    </div>
  </section>

  {{ cart_related }}


<div class="hm-light">{{ content_bottom }}</div>
</main>


<script>
/* Кількість у кошику: +/- і ручний ввід одразу оновлюють позицію та підсумки.
   Перемальовуємо тільки суми — сторінка не перезавантажується. */
(function () {
    var refreshUrl = '{{ cart_refresh_url|default('index.php?route=checkout/cart') }}';

    function repaint() {
        fetch(refreshUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');

                // порожній кошик — простіше перезавантажити, шаблон інший
                if (!doc.querySelector('.cart-list')) { location.reload(); return; }

                ['.cart-list', '.busket__totals'].forEach(function (sel) {
                    var fresh = doc.querySelector(sel);
                    var current = document.querySelector(sel);
                    if (fresh && current) current.innerHTML = fresh.innerHTML;
                });

                bind();
                if (window.jQuery) $('#cart > ul').load('index.php?route=common/cart/info ul li');
            })
            .catch(function () { location.reload(); });
    }

    function push(box) {
        var key = box.getAttribute('data-cart-qty');
        var input = box.querySelector('input');
        var val = parseInt(input.value, 10);
        if (isNaN(val) || val < 1) val = 1;
        input.value = val;

        var row = box.closest('.cart-item');
        if (row) row.classList.add('is-busy');

        fetch('index.php?route=checkout/cart/edit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'key=' + encodeURIComponent(key) + '&quantity=' + val
        })
        .then(function () { repaint(); })
        .catch(function () { location.reload(); });
    }

    function bind() {
        document.querySelectorAll('[data-cart-qty]').forEach(function (box) {
            if (box._bound) return;
            box._bound = true;

            var input = box.querySelector('input');
            var timer = null;

            box.querySelector('.product__count-minus').addEventListener('click', function () {
                var val = (parseInt(input.value, 10) || 1) - 1;
                input.value = val < 1 ? 1 : val;
                push(box);
            });

            box.querySelector('.product__count-plus').addEventListener('click', function () {
                input.value = (parseInt(input.value, 10) || 1) + 1;
                push(box);
            });

            input.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () { push(box); }, 600);
            });
        });

        // видалення позиції — теж без перезавантаження
        document.querySelectorAll('.cart-item__remove[data-cart-remove]').forEach(function (btn) {
            if (btn._bound) return;
            btn._bound = true;
            btn.addEventListener('click', function () {
                var row = btn.closest('.cart-item');
                if (row) row.classList.add('is-busy');

                fetch('index.php?route=checkout/cart/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: 'key=' + encodeURIComponent(btn.getAttribute('data-cart-remove'))
                })
                .then(function () { repaint(); })
                .catch(function () { location.reload(); });
            });
        });
    }

    bind();
})();
</script>
{{ footer }}
