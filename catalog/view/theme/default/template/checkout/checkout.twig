{{ header }}
{% if ga_checkout %}
<script>
/* GA4: початок оформлення */
if (typeof gtag === 'function') { gtag('event', 'begin_checkout', {{ ga_checkout|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}); }
</script>
{% endif %}
<main class="main main--light" id="content">
  <section class="checkout">
    <div class="container">
      {% if breadcrumbs %}
      <nav class="catalog__crumbs" aria-label="Breadcrumbs">
        {% for breadcrumb in breadcrumbs %}
        <a href="{{ breadcrumb.href }}" class="catalog__crumbs-link{% if loop.last %} is-current{% endif %}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span class="catalog__crumbs-sep" aria-hidden="true">/</span>{% endif %}
        {% endfor %}
      </nav>
      {% endif %}

      <h1 class="checkout__title page-name" style="color:#161616;">{{ heading_title }}</h1>

      <div class="checkout__inner">
        <div class="checkout__content">
          <form class="checkout__box" id="checkout-form" data-checkout-form onsubmit="return false;">

            <p class="checkout__error" data-checkout-error hidden></p>

            <div class="checkout__block">
              <h2 class="checkout__block-name">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {{ co_contacts|default('Контактні дані') }}
              </h2>
              {% if not logged %}
              {# новий покупець реєструється, наявний — входить по коду на пошту #}
              <div class="checkout__auth-tabs" data-auth-tabs>
                <button type="button" class="checkout__auth-tab is-active" data-auth-mode="register">{{ co_mode_register|default('Новий покупець') }}</button>
                <button type="button" class="checkout__auth-tab" data-auth-mode="login">{{ co_mode_login|default('Я вже маю акаунт') }}</button>
              </div>
              <p class="checkout__auth-hint" data-auth-hint>{{ co_hint_register|default('Заповніть контакти — на пошту прийде код підтвердження, і ми створимо акаунт із вашими замовленнями.') }}</p>
              {% endif %}

              <div class="checkout__block-inputs">
                <div class="account__field" data-auth-field="register">
                  <label for="co-firstname">{{ co_firstname|default("Ім'я") }}</label>
                  <input type="text" id="co-firstname" name="firstname" value="{{ customer_firstname }}" autocomplete="given-name" required>
                </div>
                <div class="account__field" data-auth-field="register">
                  <label for="co-lastname">{{ co_lastname|default('Прізвище') }}</label>
                  <input type="text" id="co-lastname" name="lastname" value="{{ customer_lastname }}" autocomplete="family-name">
                </div>
                <div class="account__field" data-auth-field="register">
                  <label for="co-phone">{{ co_telephone|default('Телефон') }}</label>
                  <input type="tel" id="co-phone" name="telephone" value="{{ customer_telephone }}" autocomplete="tel" required>
                </div>
                <div class="account__field" data-auth-field="both">
                  <label for="co-email">{{ co_email|default('E-Mail') }}</label>
                  <input type="email" id="co-email" name="email" value="{{ customer_email }}" autocomplete="email" required>
                </div>
                {% if not logged %}
                <div class="checkout__auth-login" data-auth-login hidden>
                  <button type="button" class="btn-2" data-auth-send-code>{{ co_get_code|default('Отримати код') }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </button>
                </div>
                {% endif %}
              </div>
            </div>

            <div class="checkout__block">
              <h2 class="checkout__block-name">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3M20 17h2v-6l-3-5h-5v11h3"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                {{ co_delivery|default('Доставка') }}
              </h2>
              <div class="checkout__block-delivery">
                <div class="account__field" style="grid-column: span 3;">
                  <label for="co-carrier">{{ co_carrier|default('Перевізник') }}</label>
                  <select id="co-carrier" name="shipping_method">
                    {% for carrier in carriers %}
                    <option value="{{ carrier.code }}"{% if loop.first %} selected{% endif %} data-warehouse="{{ carrier.warehouse ? 1 : 0 }}">{{ carrier.title }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="checkout__dest-types" data-dest-types style="grid-column: span 3;" hidden>
                  <span class="checkout__dest-legend">{{ co_dest_type|default('Спосіб отримання') }}</span>
                  <div class="checkout__dest-list">
                    <label class="account__radio" data-dest-option="branch"><input type="radio" name="dest_type" value="branch" checked> {{ co_dest_branch|default('Відділення') }}</label>
                    <label class="account__radio" data-dest-option="postomat"><input type="radio" name="dest_type" value="postomat"> {{ co_dest_postomat|default('Поштомат') }}</label>
                    <label class="account__radio" data-dest-option="courier"><input type="radio" name="dest_type" value="courier"> {{ co_dest_courier|default("Кур'єр на адресу") }}</label>
                  </div>
                </div>
                <div class="account__field checkout__city" style="grid-column: span 3;" data-city-wrap>
                  <label for="co-city">{{ co_city|default('Місто') }}</label>
                  <input type="text" id="co-city" name="city" value="{{ default_city }}" autocomplete="off" data-city-input>
                  <div class="checkout__suggest" data-city-list hidden></div>
                </div>
                <div class="account__field checkout__branch" style="grid-column: span 3;" data-dest-wrap>
                  <label for="co-dest" data-dest-label>{{ co_warehouse|default('Відділення') }}</label>
                  <input type="text" id="co-dest" name="destination" value="{{ default_address }}" autocomplete="off" data-dest-input>
                  <div class="checkout__suggest" data-dest-list hidden></div>
                </div>
                <p class="checkout__pickup" data-pickup-info hidden>{{ co_pickup|default('Самовивіз за адресою:') }} {{ pickup_address }}</p>
              </div>
            </div>

            <div class="checkout__block">
              <h2 class="checkout__block-name">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                {{ co_payment|default('Оплата') }}
              </h2>
              <div class="checkout__block-payments">
                {% for method in payment_methods %}
                <label class="account__radio"><input type="radio" name="payment_method" value="{{ method.code }}"{% if loop.first %} checked{% endif %}> {{ method.title }}</label>
                {% endfor %}
              </div>
            </div>

            <div class="checkout__block">
              <div class="account__field" style="max-width: 828px;">
                <label for="co-comment">{{ co_comment|default('Коментар до замовлення') }}</label>
                <textarea id="co-comment" name="comment" rows="3" placeholder="{{ co_optional|default("Необов'язково") }}"></textarea>
              </div>
            </div>


            <div class="account__actions account__actions--split" style="max-width: 828px;">
              <a href="{{ cart_link }}" class="btn-2 btn-2--ghost">{{ co_back|default('Назад у кошик') }}</a>
              <button type="button" class="btn-2" data-checkout-submit>{{ co_confirm|default('Підтвердити замовлення') }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            </div>
          </form>

          <div class="checkout__thanks" data-checkout-thanks hidden>
            <div class="account__notice account__notice--ok">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span data-thanks-text>{{ co_placed|default("Дякуємо! Замовлення прийнято — менеджер зв'яжеться з вами найближчим часом.") }}</span>
            </div>
            <div class="account__actions" style="justify-content: flex-start;">
              <a href="{{ catalog_link }}" class="btn-2">{{ co_catalog|default('До каталогу') }}</a>
            </div>
          </div>
        </div>

        <aside class="checkout__busket busket-static">
          <div class="busket__top">
            <p class="busket__title">{{ co_your_order|default('Ваше замовлення') }}</p>
          </div>

          <div class="checkout__items">
            {% for product in products %}
            <div class="checkout__item">
              <img class="checkout__item-img" src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">
              <div class="checkout__item-body">
                <a class="checkout__item-name" href="{{ product.href }}">{{ product.name }}</a>
                <span class="checkout__item-meta">{{ product.quantity }} &times; {{ product.price }}</span>
              </div>
              <span class="checkout__item-total">{{ product.total }}</span>
            </div>
            {% endfor %}
          </div>

          <div class="busket__totals">
            {% for total in totals %}
            <div class="busket__total-row{% if loop.last %} busket__total-row--final{% endif %}">
              <span>{{ total.title }}</span>
              <b>{{ total.text }}</b>
            </div>
            {% endfor %}
          </div>

          {{ cart_related }}
        </aside>
      </div>
    </div>
  </section>


  {{ content_bottom }}
</main>


<script>
window.hpCheckout = {
    logged: {{ logged ? 'true' : 'false' }},
    defaultDestType: {{ default_dest_type|default('')|json_encode|raw }},
    citySearch: {{ city_search_url|json_encode|raw }},
    warehouseSearch: {{ warehouse_search_url|json_encode|raw }},
    pickupAddress: {{ pickup_address|json_encode|raw }},
    labels: {
        branch: {{ co_warehouse|default('Відділення')|json_encode|raw }},
        postomat: {{ co_dest_postomat|default('Поштомат')|json_encode|raw }},
        courier: {{ co_address|default('Адреса доставки')|json_encode|raw }}
    },
    placeholders: {
        branch: {{ co_ph_branch|default('Почніть вводити номер або вулицю')|json_encode|raw }},
        postomat: {{ co_ph_postomat|default('Почніть вводити номер поштомата')|json_encode|raw }},
        courier: {{ co_ph_courier|default('Вулиця, будинок, квартира')|json_encode|raw }}
    },
    otpTitle: {{ co_otp_title|default('Підтвердження пошти')|json_encode|raw }},
    text: {
        hintRegister: {{ co_hint_register|default('Заповніть контакти — на пошту прийде код підтвердження, і ми створимо акаунт із вашими замовленнями.')|json_encode|raw }},
        hintLogin: {{ co_hint_login|default('Вкажіть пошту акаунта — надішлемо код для входу, контакти підставляться автоматично.')|json_encode|raw }},
        email: {{ co_err_email|default('Вкажіть коректну пошту')|json_encode|raw }},
        city: {{ co_err_city|default('Вкажіть населений пункт')|json_encode|raw }},
        warehouse: {{ co_err_warehouse|default('Оберіть відділення')|json_encode|raw }},
        postomat: {{ co_err_postomat|default('Оберіть поштомат')|json_encode|raw }},
        address: {{ co_err_address|default('Вкажіть адресу доставки')|json_encode|raw }},
        common: {{ co_err_common|default('Не вдалося оформити замовлення. Спробуйте ще раз.')|json_encode|raw }}
    }
};
</script>
<script src="catalog/view/theme/default/js/checkout-onepage.js?v=20260901f"></script>
{{ footer }}
