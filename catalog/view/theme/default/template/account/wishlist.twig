{{ header }}
<main class="main">
<section class="account" id="account-wishlist">
    <div class="container">
        <nav class="account__crumbs">
            {% for breadcrumb in breadcrumbs %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span>/</span>{% endif %}
            {% endfor %}
        </nav>

                {% if success %}
        <div class="hp-toast hp-toast--ok" data-toast>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{{ success }}</span>
            <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>
        {% endif %}


        <div class="row">{{ column_left }}
        {% if column_left and column_right %}
        {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
        {% set class = 'col-sm-9' %}
        {% else %}
        {% set class = 'col-sm-12' %}
        {% endif %}
        <div id="content" class="{{ class }}">{{ content_top }}

        <h1 class="account__title">{{ heading_title }}</h1>

        {% if products %}
        <div class="account__wishlist">
            {% for product in products %}
            <div class="product__item">
                {% if product.thumb %}
                <a class="product__item-image" href="{{ product.href }}">
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" width="450" height="450">
                </a>
                {% endif %}
                <div class="product__item-content">
                    <a class="product__item-title" href="{{ product.href }}">
                        <h3>{{ product.name }}{% if product.model %} <span>{{ product.model }}</span>{% endif %}</h3>
                    </a>
                    {% if product.price %}
                    <p class="product__item-price">
                        {% if not product.special %}
                        {{ product.price }}
                        {% else %}
                        {{ product.special }} <s>{{ product.price }}</s>
                        {% endif %}
                    </p>
                    {% endif %}
                    <div class="account__wishlist-actions">
                        <button type="button" class="btn-2 account__wishlist-add" onclick="cart.add('{{ product.product_id }}');" title="{{ button_cart }}" data-in-text="{{ text_added_short|default('Додано') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21 7H6"/></svg>
                            <span data-cart-label>{{ button_add_short|default('Додати') }}</span>
                        </button>
                        <a href="{{ product.remove }}" class="account__wishlist-remove" title="{{ button_remove }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="account__empty">{{ text_empty }}</p>
        {% endif %}

        <div class="account__actions" style="justify-content: flex-end;">
            <a href="{{ continue }}" class="btn-2">{{ button_continue }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
        </div>

        {{ content_bottom }}</div>
        {{ column_right }}</div>
    </div>
</section>
</main>
{{ footer }}
