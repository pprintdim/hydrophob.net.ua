{{ header }}
<main class="main">
<section class="account" id="account-account">
    <div class="container">
        <nav class="account__crumbs">
            {% for breadcrumb in breadcrumbs %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span>/</span>{% endif %}
            {% endfor %}
        </nav>

                {% if success %}
        <div class="hp-toast hp-toast--ok" data-toast>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{{ success }}</span>
            <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>
        {% endif %}


        <div class="row">{{ column_left }}
        {% if column_left and column_right %}
        {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
        {% set class = 'col-sm-9' %}
        {% else %}
        {% set class = 'col-sm-12' %}
        {% endif %}
        <div id="content" class="{{ class }}">{{ content_top }}
        <h1 class="account__title">{{ text_my_account }}</h1>

        <form class="account__form" data-account-form>
            <div class="account__panel account__fieldset">
                <div class="account__notice account__notice--ok account__notice--float" data-save-ok hidden>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>{{ text_saved|default('Збережено') }}</span>
                </div>
                <h2 class="account__legend">{{ text_personal_data|default('Особисті дані') }}</h2>
                <div class="account__form-grid">
                    <div class="account__field">
                        <label for="input-firstname">{{ entry_firstname|default("Ім'я") }}</label>
                        <input type="text" name="firstname" value="{{ firstname }}" id="input-firstname" required />
                    </div>
                    <div class="account__field">
                        <label for="input-lastname">{{ entry_lastname|default('Прізвище') }}</label>
                        <input type="text" name="lastname" value="{{ lastname }}" id="input-lastname" />
                    </div>
                    <div class="account__field">
                        <label for="input-email">{{ entry_email|default('E-Mail') }}</label>
                        <div class="account__email-row" data-email-row data-current-email="{{ email }}">
                            <input type="email" name="email" value="{{ email }}" id="input-email" data-code-email />
                            <button type="button" class="btn-2 account__email-code" data-code-trigger data-code-type="email" data-code-title="{{ otp_email_title|default('Підтвердження нової пошти') }}" title="{{ otp_get_code|default('Отримати код') }}" aria-label="{{ otp_get_code|default('Отримати код') }}" disabled><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg></button>
                        </div>
                        <p class="account__hint account__hint--email">{{ text_email_change_hint|default('Щоб змінити e-mail, введіть нову адресу — надішлемо код підтвердження.') }}</p>
                    </div>
                    <div class="account__field">
                        <label for="input-telephone">{{ entry_telephone|default('Телефон') }}</label>
                        <input type="tel" name="telephone" value="{{ telephone }}" id="input-telephone" required />
                    </div>
                </div>

                <label class="account__checkbox account__newsletter-toggle">
                    <input type="checkbox" name="newsletter" value="1"{% if newsletter %} checked{% endif %} />
                    {{ text_newsletter_toggle|default('Отримувати новини та акції на пошту') }}
                </label>

                <p class="account__field-error" data-save-error hidden></p>

                <div class="account__actions">
                    <button type="submit" class="btn-2">{{ button_save|default('Зберегти') }}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </button>
                </div>
            </div>
        </form>

        {{ content_bottom }}</div>
        </div>
    </div>
</section>
</main>

<script>
/* збереження даних кабінету без перезавантаження; e-mail іде окремим потоком через код */
(function () {
    var form = document.querySelector('[data-account-form]');
    if (!form) return;

    var errBox = form.querySelector('[data-save-error]');
    var okBox = form.querySelector('[data-save-ok]');

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        errBox.hidden = true;
        okBox.hidden = true;

        var fd = new FormData(form);
        fd.delete('email'); // пошта міняється лише через код підтвердження

        var telField = form.querySelector('[name="telephone"]');
        if (telField && window.hpPhoneValue) fd.set('telephone', window.hpPhoneValue(telField));

        fetch('{{ save_action }}', {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (json) {
            if (json.redirect) { window.location.href = json.redirect; return; }

            if (json.error) {
                errBox.textContent = Object.values(json.error).join(' ');
                errBox.hidden = false;
                return;
            }

            okBox.hidden = false;
            clearTimeout(okBox._t);
            okBox._t = setTimeout(function () { okBox.hidden = true; }, 3000);
        })
        .catch(function () {
            errBox.textContent = 'Помилка. Спробуйте ще раз.';
            errBox.hidden = false;
        });
    });
})();

/* кнопка коду для e-mail активна лише коли адреса нова і валідна */
(function () {
    var row = document.querySelector('[data-email-row]');
    if (!row) return;
    var input = row.querySelector('input[name="email"]');
    var btn = row.querySelector('[data-code-trigger]');
    var current = (row.getAttribute('data-current-email') || '').trim().toLowerCase();

    function sync() {
        var v = input.value.trim().toLowerCase();
        var ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) && v !== current;
        btn.disabled = !ok;
        btn.classList.toggle('is-disabled', !ok);
    }

    input.addEventListener('input', sync);
    input.addEventListener('blur', sync);
    sync();
})();
</script>
{{ footer }}
