{{ header }}
<main class="main" id="content">
<section class="account" id="account-login">
    <div class="container">
        <nav class="account__crumbs">
            {% for breadcrumb in breadcrumbs %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span>/</span>{% endif %}
            {% endfor %}
        </nav>

                {% if success %}
        <div class="hp-toast hp-toast--ok" data-toast>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{{ success }}</span>
            <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>
        {% endif %}

                {% if error_warning %}
        <div class="hp-toast hp-toast--error" data-toast>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 17h.01"/></svg>
            <span>{{ error_warning }}</span>
            <button type="button" class="hp-toast__close" data-toast-close aria-label="×">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>
        {% endif %}


        <div class="row">{{ column_left }}
        {% if column_left and column_right %}
        {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
        {% set class = 'col-sm-9' %}
        {% else %}
        {% set class = 'col-sm-12' %}
        {% endif %}
        <div id="content" class="{{ class }}">{{ content_top }}

        <h1 class="account__title">{{ otp_page_title }}</h1>
        <p class="account__lead">{{ otp_page_lead }}</p>

        <div class="account__otp-steps">
            <span class="account__otp-step-badge is-active">
                <span class="account__otp-step-num">1</span> {{ otp_step1 }}
            </span>
            <span class="account__otp-step-badge is-active">
                <span class="account__otp-step-num">2</span> {{ otp_step2 }}
            </span>
            <span class="account__otp-step-badge is-active">
                <span class="account__otp-step-num">3</span> {{ otp_step3 }}
            </span>
        </div>

        <div class="account__panel account__fieldset">
            <div class="account__form-grid">
                <div class="account__field account__field-full">
                    <label for="input-email">{{ entry_email }}</label>
                    <div class="account__email-row">
                        <input type="email" placeholder="you@example.com" id="input-email" autocomplete="email" value="{{ email }}" data-code-email />
                        <button type="button" class="btn-2 account__email-send" data-code-trigger data-code-type="login" data-code-title="{{ otp_login_title }}"{% if redirect_checkout %} data-code-redirect="checkout"{% endif %}>{{ otp_get_code }}
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
                        </button>
                    </div>
                    <p class="account__error" data-code-inline-error hidden></p>
                </div>
            </div>
            <p class="account__hint">{{ otp_no_account }} <a href="{{ register }}">{{ otp_register_link }}</a></p>
        </div>

        {{ content_bottom }}</div>
        {{ column_right }}</div>
    </div>
</section>
</main>
{{ footer }}
