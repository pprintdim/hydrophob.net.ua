{{ header }}
<main class="main">
<section class="account" id="account-order">
    <div class="container">
        <nav class="account__crumbs">
            {% for breadcrumb in breadcrumbs %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span>/</span>{% endif %}
            {% endfor %}
        </nav>

        <div class="row">{{ column_left }}
        <div id="content">{{ content_top }}
            <h1 class="account__title page-name">{{ heading_title }}</h1>

            {% if orders %}
            <div class="order-list">
                {% for order in orders %}
                <div class="order" data-order>
                    <button type="button" class="order__row" data-order-toggle data-details="{{ order.details }}" aria-expanded="false">
                        <span class="order__col order__col--id">
                            <span class="order__label">{{ column_order_id|default('Замовлення') }}</span>
                            <span class="order__value">№{{ order.order_id }}</span>
                        </span>
                        <span class="order__col">
                            <span class="order__label">{{ column_date_added|default('Дата') }}</span>
                            <span class="order__value">{{ order.date_added }}</span>
                        </span>
                        <span class="order__col">
                            <span class="order__label">{{ column_total|default('Сума') }}</span>
                            <span class="order__value">{{ order.total }}</span>
                        </span>
                        <span class="order__status">{{ order.status }}</span>
                        <span class="order__chevron" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </span>
                    </button>
                    <div class="order__panel" data-order-details hidden></div>
                </div>
                {% endfor %}
            </div>

            {% if pagination %}
            <div class="account__pagination">{{ pagination }}</div>
            {% endif %}
            {% else %}
            <div class="account__empty">
                <span class="account__empty-icon" aria-hidden="true">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </span>
                <p class="account__empty-title">{{ text_no_results|default('Замовлень ще немає') }}</p>
                <a href="{{ catalog_link|default('/katalog') }}" class="btn-2">{{ button_catalog|default('До каталогу') }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            </div>
            {% endif %}

            {{ content_bottom }}</div>
        {{ column_right }}</div>
    </div>
</section>
</main>
<script>
/* Деталі замовлення розкриваються в самому списку — окремої сторінки немає */
document.querySelectorAll('[data-order-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
        var box = btn.closest('[data-order]');
        var panel = box.querySelector('[data-order-details]');
        var open = box.classList.toggle('is-open');

        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.hidden = !open;

        if (open && !panel.dataset.loaded) {
            panel.innerHTML = '<p class="order__loading">…</p>';

            fetch(btn.getAttribute('data-details'), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    panel.innerHTML = html;
                    panel.dataset.loaded = '1';
                })
                .catch(function () { panel.innerHTML = ''; });
        }
    });
});
</script>
{{ footer }}
