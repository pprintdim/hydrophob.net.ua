                        </div>
                        {% endif %}


						 {% if comment %}
							<br /><strong>{{ text_comment }}</strong><br />
								{{ comment }}
						{% endif %}
                    </div>
                    <div class="contacts__map">
                        {% if contact_video %}
                        <div class="contacts__media">
                            <video src="{{ contact_video }}"{% if contact_poster %} poster="{{ contact_poster }}"{% endif %} autoplay muted loop playsinline></video>
                            <button type="button" class="hero__sound" data-media-sound aria-label="{{ text_sound_on }}" aria-pressed="false">
                                <svg class="hero__sound-off" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/></svg>
                                <svg class="hero__sound-on" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><path d="M11 5 6 9H2v6h4l5 4zM15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                            </button>
                        </div>
                        {% endif %}
						{% if map_lat and map_lng %}
						<div class="contacts__map-canvas" id="contacts-map" data-lat="{{ map_lat }}" data-lng="{{ map_lng }}" data-title="{{ map_title }}" data-address="{{ address }}"></div>
						{% endif %}
					</div>
                </div>
                        {% if help_items %}
                        <div class="contacts__help">
                            {% for item in help_items %}
                            <div class="contacts__help-item">
                                <p class="contacts__help-name">{{ item.name }}</p>
                                <p class="contacts__help-text">{{ item.text }}</p>
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}
            </div>
        </section>
{{ content_bottom }}
	</main>
<script>
/* карта контактів: OpenStreetMap за координатами з Налаштувань (config_geocode) */
document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('contacts-map');
    if (!el || !window.hpLeaflet) return;

    var lat = parseFloat(el.getAttribute('data-lat'));
    var lng = parseFloat(el.getAttribute('data-lng'));
    if (isNaN(lat) || isNaN(lng)) return;

    // Leaflet тягнемо лише коли карта доїхала до екрана (хелпери у футері)
    window.hpWhenVisible(el, function () { window.hpLeaflet(draw); });

    function draw() {
    var map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([lat, lng], 16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

    var gmaps = 'https://www.google.com/maps/search/?api=1&query=' + lat + ',' + lng;

    // маркер у фірмовому зеленому — стандартний синій PNG Leaflet не в стилі
    var pin = L.divIcon({
        className: 'hp-map-pin',
        html: '<svg width="34" height="44" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.4 0 0 5.4 0 12c0 8.4 12 20 12 20s12-11.6 12-20c0-6.6-5.4-12-12-12z" fill="#A7C70E"/><circle cx="12" cy="12" r="4.4" fill="#ffffff"/></svg>',
        iconSize: [34, 44],
        iconAnchor: [17, 44]
    });

    var marker = L.marker([lat, lng], { icon: pin })
        .addTo(map)
        .on('click', function () { window.open(gmaps, '_blank', 'noopener'); });

    // при наведенні показуємо адресу магазину
    var address = (el.getAttribute('data-address') || el.getAttribute('data-title') || '').trim();

    if (address) {
        marker.bindTooltip(address, { direction: 'top', offset: [0, -38], className: 'hp-map-tip' });
    }
    }
});
</script>
{{ footer }}