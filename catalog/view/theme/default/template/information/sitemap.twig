{{ header }}
<main class="main main--light" id="content">
  <section class="sitemap-page">
    <div class="container">
      {% if breadcrumbs %}
      <nav class="catalog__crumbs" aria-label="Breadcrumbs">
        {% for breadcrumb in breadcrumbs %}
        <a href="{{ breadcrumb.href }}" class="catalog__crumbs-link{% if loop.last %} is-current{% endif %}">{{ breadcrumb.text }}</a>{% if not loop.last %}<span class="catalog__crumbs-sep" aria-hidden="true">/</span>{% endif %}
        {% endfor %}
      </nav>
      <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for breadcrumb in breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ breadcrumb.text|json_encode }},"item":{{ breadcrumb.href|json_encode }}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
      {% endif %}
      {% for block in schema_blocks %}
      <script type="application/ld+json">{{ block|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
      {% endfor %}

      <h1 class="sitemap-page__title page-name">{{ heading_title }}</h1>

      <div class="sitemap-page__grid">
        {% if categories %}
        <div class="sitemap-page__col">
          <h2 class="sitemap-page__name">{{ text_catalog }}</h2>
          <ul class="sitemap-page__list">
            {% for category_1 in categories %}
            <li>
              <a href="{{ category_1.href }}">{{ category_1.name }}</a>
              {% if category_1.children %}
              <ul class="sitemap-page__sub">
                {% for category_2 in category_1.children %}
                <li>
                  <a href="{{ category_2.href }}">{{ category_2.name }}</a>
                  {% if category_2.children %}
                  <ul class="sitemap-page__sub">
                    {% for category_3 in category_2.children %}
                    <li><a href="{{ category_3.href }}">{{ category_3.name }}</a></li>
                    {% endfor %}
                  </ul>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% for group in groups %}
        <div class="sitemap-page__col">
          <h2 class="sitemap-page__name">{{ group.title }}</h2>
          <ul class="sitemap-page__list">
            {% for link in group.links %}
            <li><a href="{{ link.href }}">{{ link.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {{ content_bottom }}
</main>
{{ footer }}
